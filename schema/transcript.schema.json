{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas supplied transcript",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "provenance",
    "limitations",
    "passages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "limitations": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "source_url",
        "source_title",
        "source_date",
        "transcript_origin"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^FKA-[0-9]{3}$"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "source_title": {
          "type": "string",
          "minLength": 1
        },
        "source_date": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "transcript_origin": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "transcript_sha256",
        "method",
        "importer_version"
      ],
      "properties": {
        "transcript_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "method": {
          "type": "string"
        },
        "importer_version": {
          "const": 1
        }
      }
    },
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "passage_id",
          "source_id",
          "start_ms",
          "end_ms",
          "speaker",
          "text",
          "citation_url",
          "review_status"
        ],
        "properties": {
          "passage_id": {
            "type": "string",
            "pattern": "^FKA-[0-9]{3}-P-[0-9a-f]{16}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^FKA-[0-9]{3}$"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "speaker": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "citation_url": {
            "type": "string",
            "format": "uri"
          },
          "review_status": {
            "const": "unreviewed"
          }
        }
      }
    }
  }
}
